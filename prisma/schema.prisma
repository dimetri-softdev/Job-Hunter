datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  roadmaps  Roadmap[]
  createdAt DateTime  @default(now())
}

model Roadmap {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole     String
  readinessScore Int
  gapAnalysis    String
  projects       String   // Changed from Json to String for SQLite compatibility
  createdAt      DateTime @default(now())
}