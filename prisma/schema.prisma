datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider  = "prisma-client-py"
  interface = "asyncio"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  roadmaps  Roadmap[]
  createdAt DateTime  @default(now())
}

model Roadmap {
  id             String         @id @default(uuid())
  title          String
  readinessScore Int            @default(75)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects       ProjectTrack[]
  createdAt      DateTime       @default(now())
}

model ProjectTrack {
  id          String   @id @default(uuid())
  title       String
  description String
  level       String   @default("INTERMEDIATE")
  roadmapId   String
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {
  id             String       @id @default(uuid())
  label          String
  completed      Boolean      @default(false)
  projectTrackId String
  projectTrack   ProjectTrack @relation(fields: [projectTrackId], references: [id], onDelete: Cascade)
}