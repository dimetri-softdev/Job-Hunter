generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id
  email             String        @unique
  name              String?
  careerSummary     String?
  skills            String?
  workHistory       String?
  education         String?
  accomplishments   String?
  experienceLevel   String?
  targetRoles       String?
  preferredLocation String?
  workArrangement   String?
  offerPriorities   Json?
  applicationProfile ApplicationProfile?
  roadmaps          Roadmap[]
  applications      Application[]
  subscription      UserSubscription?
  billingUsage      BillingUsageEvent[]
  createdAt         DateTime       @default(now())
}

model ApplicationProfile {
  id                         String                                @id @default(uuid())
  userId                     String                                @unique
  user                       User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                  String?
  email                     String?
  phone                     String?
  city                      String?
  state                     String?
  country                   String?
  postalCode                String?
  addressLine1              String?
  addressLine2              String?
  linkedInUrl               String?
  githubUrl                 String?
  portfolioUrl              String?
  noticePeriod              String?
  workAuthorization         String?
  salaryExpectation         String?
  eeoData                   Json?
  privacyConsentAccepted     Boolean                               @default(false)
  workAuthorizationConsent   Boolean                               @default(false)
  salaryExpectationConsent   Boolean                               @default(false)
  eeoDataConsent             Boolean                               @default(false)
  createdAt                 DateTime                              @default(now())
  updatedAt                 DateTime                              @updatedAt
  workHistory               ApplicationProfileWorkHistoryEntry[]
  education                 ApplicationProfileEducationEntry[]
  skills                    ApplicationProfileSkill[]
  savedAnswers              ApplicationProfileAnswer[]
}

model ApplicationProfileWorkHistoryEntry {
  id          String             @id @default(uuid())
  profileId   String
  profile     ApplicationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company     String?
  title       String?
  location    String?
  startDate   String?
  endDate     String?
  isCurrent   Boolean            @default(false)
  description String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([profileId])
}

model ApplicationProfileEducationEntry {
  id            String             @id @default(uuid())
  profileId     String
  profile       ApplicationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  school        String?
  degree        String?
  fieldOfStudy  String?
  startDate     String?
  endDate       String?
  location      String?
  description   String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([profileId])
}

model ApplicationProfileSkill {
  id          String             @id @default(uuid())
  profileId   String
  profile     ApplicationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  proficiency String?
  createdAt   DateTime           @default(now())

  @@index([profileId])
}

model ApplicationProfileAnswer {
  id          String             @id @default(uuid())
  profileId   String
  profile     ApplicationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  questionKey String
  answerText  String             @db.Text
  isSensitive Boolean            @default(false)
  consentGiven Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([profileId, questionKey])
  @@index([profileId])
}

model Roadmap {
  id             String         @id @default(uuid())
  title          String
  readinessScore Int
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId  String?
  application    Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  projects       ProjectTrack[]
  createdAt      DateTime       @default(now())

  @@index([applicationId])
}

model ProjectTrack {
  id          String   @id @default(uuid())
  title       String
  description String
  level       String
  proofUrl    String?
  proofNotes  String?
  roadmapId   String
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {
  id             String       @id @default(uuid())
  label          String
  completed      Boolean      @default(false)
  projectTrackId String
  projectTrack   ProjectTrack @relation(fields: [projectTrackId], references: [id], onDelete: Cascade)
}

model Application {
  id             String   @id @default(cuid())
  company        String
  position       String
  status         String   @default("APPLIED")
  notes          String?
  jobUrl         String?
  jobDescription String?
  jobSummary     String?
  fitAssessment  Json?
  offerDetails   Json?
  nextAction     String?
  followUpAt     DateTime? @db.Date
  roadmaps       Roadmap[]
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FeedbackResponse {
  id        String   @id @default(uuid())
  answers   Json
  createdAt DateTime @default(now())
}

model BillingConfiguration {
  id           String   @id
  enabled      Boolean  @default(false)
  supportEmail String   @default("jobhunter408@gmail.com")
  updatedBy    String?
  updatedAt    DateTime @updatedAt
}

model UserSubscription {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   String
  status                 String
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  paymentFailedAt        DateTime?
  canceledAt             DateTime?
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?  @unique
  billingInterval        String   @default("monthly")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model PayfastCheckout {
  id                     String   @id @default(uuid())
  userId                 String
  plan                   String
  billingInterval        String
  amount                 Decimal  @db.Decimal(10, 2)
  status                 String   @default("PENDING")
  providerSubscriptionId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId, createdAt])
}

model PayfastNotification {
  id                     String   @id @default(uuid())
  providerPaymentId      String   @unique
  merchantReference      String
  providerSubscriptionId String?
  paymentStatus          String
  amount                 Decimal  @db.Decimal(10, 2)
  receivedAt             DateTime @default(now())

  @@index([merchantReference])
  @@index([providerSubscriptionId])
}

model BillingUsageEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   String
  status    String   @default("RESERVED")
  createdAt DateTime @default(now())

  @@index([userId, feature, createdAt])
}

model BillingAuditLog {
  id             String   @id @default(uuid())
  actorId        String
  actorEmail     String
  subjectUserId  String?
  action         String
  details        Json
  createdAt      DateTime @default(now())

  @@index([subjectUserId, createdAt])
}
